# Copy to .env. See docs/config.md.

AGENT_EMAIL=agent@example.com
MANAGER_EMAIL=manager@example.com

# Prod: anthropic:claude-sonnet-5-5, no base URL
# Dev: openai:sonnet, http://wrapper:8000/v1
LLM_MODEL=anthropic:claude-sonnet-5-5
LLM_BASE_URL=

# Quote a list with spaces: "acme.ai, acme.com"
INTERNAL_DOMAINS=
INTERNAL_ADDRESSES=
BULK_DOMAINS=

POLL_SECONDS=5
TIME_ZONE=Europe/Bucharest
MEETING_DEFAULT_TIME=10:00
MEETING_DURATION_MINUTES=30
SEND_SALES_DECLINE=true

# Host runs only. Containers use the defaults.
# SECRETS_DIR=./secrets
# DATA_DIR=./data
